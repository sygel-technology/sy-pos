<odoo>
    <record id="pos_discount_per_line_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">pos.discount.per.line.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='manual_discount']" position="after">
                <setting
                    help="Choose your discount per line's default method. 'Replace' will replace the current discount applied on every line. 'Sum' will sum the selected discount to the current discount on each line."
                >
                    <field name="discount_per_line" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
