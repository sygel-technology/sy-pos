<templates id="template" xml:space="preserve">
    <t
        t-name="pos_discount_per_line.NumberPopupDPL"
        t-inherit="point_of_sale.NumberPopup"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//div[@t-if='props.subtitle']" position="after">
            <div>
                <select
                    name="disc_policy"
                    id="disc_policy"
                    class="form-select form-select-sm fw-bolder mb-2 text-center"
                >
                    <option
                        value="replace"
                        t-att-selected="props.discountPerLineMethod == 'replace'"
                    >
                        <span>Replace</span>
                    </option>
                    <option
                        value="sum"
                        t-att-selected="props.discountPerLineMethod == 'sum'"
                    >
                        <span>Sum</span>
                    </option>
                </select>
            </div>
        </xpath>
    </t>
</templates>
