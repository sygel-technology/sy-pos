<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="pos_discount_per_line.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton"
            position="after"
        >
            <button
                class="js_discount"
                t-att-class="buttonClass"
                t-on-click="() => this.clickDiscountPerLine()"
            >
                <i class="fa fa-tags me-1" />Discount Per Line
            </button>
        </xpath>
    </t>
</templates>
